# Copy to .env.local for local builds. All values are optional.

# Sub-folder the site is served from. Empty for a root domain (Hostinger, haaps.in).
NEXT_PUBLIC_BASE_PATH=
# Full public address of the site, used for the sitemap and SEO tags.
NEXT_PUBLIC_SITE_URL=https://www.haaps.in

# Where lead forms are sent (e.g. https://formspree.io/f/xxxx or https://api.web3forms.com/submit).
# Leave empty to send leads to WhatsApp instead.
NEXT_PUBLIC_FORM_ENDPOINT=
# Only for services that need a key in the request body (Web3Forms "access_key").
NEXT_PUBLIC_FORM_ACCESS_KEY=
